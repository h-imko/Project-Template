{
	"name": "project-template",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "npx tsx ./node_modules/gulp/bin/gulp.js --ram --fwatch --gulpfile ./gulpfile.mts",
		"build": "npx tsx ./node_modules/gulp/bin/gulp.js --gulpfile ./gulpfile.mts",
		"build_min": "npx tsx ./node_modules/gulp/bin/gulp.js --gulpfile ./gulpfile.mts --min",
		"build_watch": "npx tsx ./node_modules/gulp/bin/gulp.js --gulpfile ./gulpfile.mts --fwatch",
		"build_watch_min": "npx tsx ./node_modules/gulp/bin/gulp.js --gulpfile ./gulpfile.mts --fwatch --min",
		"imagemin": "npx tsx ./node_modules/gulp/bin/gulp.js --gulpfile ./gulpfile.mts imageMin",
		"ttfToWoff": "npx tsx ./node_modules/gulp/bin/gulp.js --gulpfile ./gulpfile.mts ttfToWoff",
		"init": "npm i && npx tsx ./node_modules/gulp/bin/gulp.js --gulpfile ./gulpfile.mts cleanInitials"
	},
	"devDependencies": {
		"@types/gulp": "^4.0.18",
		"@types/react": "^19.2.13",
		"@types/react-dom": "^19.2.3",
		"browser-sync": "^3.0.4",
		"esbuild": "^0.27.3",
		"gulp": "^5.0.1",
		"gulp-autoprefixer": "^10.0.0",
		"gulp-esbuild": "^0.14.1",
		"gulp-mem": "^0.1.3",
		"gulp-rename": "^2.1.0",
		"gulp-sass": "^6.0.1",
		"gulp-sourcemaps": "^3.0.0",
		"gulp-stacksvg": "^6.0.0",
		"react-dom": "^19.2.4",
		"sass-embedded": "^1.97.3",
		"sharp": "^0.34.5",
		"svgo": "^4.0.0",
		"tsx": "^4.21.0",
		"vinyl": "^3.0.1",
		"wawoff2": "^2.0.1"
	},
	"dependencies": {
		"@splidejs/splide": "^4.1.4"
	}
}